@{
    ViewData["Title"] = "DevConnect - Feed";
}



<link rel="stylesheet" href="~/css/feed.css" />

@model List<DevConnect.Models.TbPostagem>

<script defer>
    const PublicacaoNovaCadastro = '@ViewBag.PublicacaoNovaCadastro';

    if (PublicacaoNovaCadastro == "Nao cadastrado") {
        alert("Nao e possivel realizar publicacao. Tente novamente mais tarde.");
    }
    else if (PublicacaoNovaCadastro == "Cadastrado") {
        alert("Publicacao realizada com sucesso!");
    }
</script>



<header id="cabecalho">
    <nav>
        <a id="logo-desktop" href="./feed.html">
            <img src="../images/logotipo_mobile.svg" alt="Logo da empresa DevConnect">
        </a>
        <a id="logo-mobile" href="./feed.html">
            <img src="../images/logotipo-4.svg" alt="Logo da empresa DevConnect">
        </a>

        <div class="cabecalho-acoes">

            <a asp-controller="Home" asp-action="Index">
                <img src="../images/iconecasa_svg2.svg" alt="Icone de casa">
            </a>
            <a href="#">
                <img src="../images/iconecoracao_2svg.svg" alt="Icone de coração">
            </a>

            <a asp-controller="Usuario" asp-action="Perfil">
                <img class="foto-perfil" src="../images/veiga.selfie.jpg" alt="">
