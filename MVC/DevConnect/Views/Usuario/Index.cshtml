@model DevConnect.Models.TbUsuario;

<h1>Tela cadastro</h1>

<link rel="stylesheet" href="~/css/cadastro.css" />

<script defer>
    const UsuarioNovoCadastro = "@ViewBag.UsuarioNovoCadastro";

    if(UsuarioNovoCadastro == "Nao cadastrado"){
        alert("Usuário não cadastrado. Tente novamente.");
    }
        
</script>


        <main>
            <div>
                <!-- formulario -->
                <form id="formulario" class="estilo-formulario" enctype="multipart/form-data" asp-action="Index" asp-controller="Usuario">
                    <img src="../images/logotipo_mobile.svg" alt="">

                    <p>Cadastre-se para comunidade exclusiva de desenvolvedores</p>

                    <div>
                        <label for="">Nome e sobrenome</label>
                        <input type="text" asp-for=NomeCompleto>
                    </div>
                    
                    <div>
                        <label for="">Nome de usuário </label>
                        <input type="text" asp-for=NomeUsuario>
                    </div>


                    <div>
                        <label for="">Email</label>
                        <input type="email" asp-for="Email">
                    </div>

                    <div>
                        <label for=""> Senha </label>
                        <input type="password" asp-for="Senha">
                    </div>

                    <label for="arquivo" class="formulario-botao-cinza">Faça o upload da sua imagem</label input type="file" id="arquivo" name="imagem">
                    <input type="file" id="arquivo" name="imagem">

                    <button type="submit" class="formulario-botao-verde">Cadastrar-se</button>

                    <p class="politica de cookies">Ao se cadastrar, você concorda com nossos Termos, Política de Dados e Política de Cookies.</p>

                </form>

                <!-- conecte -->
                <section id="conta-conecte" class="estilo-formulario">
                    <p>Tem uma conta? <a asp-controller="Home" asp-action="Index"">Conecte-se</a></p>
                </section>

            </div>
        </main>